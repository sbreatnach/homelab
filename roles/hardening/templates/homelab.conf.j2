[dovecot]
enabled = true
port    = pop3,pop3s,imap2,imaps,submission,465,sieve

[postfix]
enabled = true

[matrix-synapse]
enabled = true
filter = matrix-synapse
logpath = /var/log/matrix-synapse/homeserver.log
maxretry = 5

[keycloak]
enabled = true
port = https,8080
logpath = /home/auth/keycloak/data/log/keycloak.log
maxretry = 6
findtime = 600
bantime = 600

[vaultwarden]
enabled = true
port = http,https,8715
filter = vaultwarden
logpath = /var/log/vaultwarden.log
maxretry = 3
findtime = 600
bantime = 3600
backend = auto
